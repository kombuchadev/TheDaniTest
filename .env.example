# ---------------------------------------------------------------------------
# Public site URL
#
# Makes every Open Graph tag absolute. Without it the link preview image
# resolves relative and crawlers cannot fetch it, so a shared verdict unfurls
# as a bare link with no card. On Vercel the stable production URL is picked
# up automatically; set this only once there is a custom domain.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# LLM providers. All free tiers, no card required.
#
# Add a key and that provider joins in. Leave the *_MODEL lines blank: each
# provider then uses the model list in lib/providers/registry.ts, picked by
# running every candidate through /api/dev/probe (dev server only) and keeping
# the ones that actually produced a verdict. A *_MODEL value (comma separated
# for several) replaces that list entirely, so a stale pin undoes the tuning.
#
# Free limits are per model, so several models on one provider means several
# allowances. The chain alternates between providers, starts a backup request
# when one is slow, and skips models that failed recently.
#
# After adding a key: `npm run models` lists what the provider serves (free),
# and /api/dev/probe shows which of those actually work (costs a few tokens).
#
# On Vercel, variables only take effect after a redeploy.
# ---------------------------------------------------------------------------

# Groq. https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=

# Google Gemini. https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=

# OpenRouter. https://openrouter.ai/keys
#   50 requests/day across its free models on an unfunded account.
#   Browse free models: https://openrouter.ai/models?max_price=0
#   Avoid "openrouter/free": in testing it routed to a safety classifier
#   that returns no verdict.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# --- Optional. No default models: add a key, probe, then pin what passes. ---

# NVIDIA NIM. https://build.nvidia.com (wants a phone number)
NVIDIA_API_KEY=
NVIDIA_MODEL=

# GitHub Models. A fine-grained token with only models:read, from
# https://github.com/settings/tokens. Never reuse a gh CLI token here: those
# carry full repo access and this value ends up on a public server.
GITHUB_MODELS_TOKEN=
GITHUB_MODEL=

# Mistral. https://console.mistral.ai (wants a phone number)
MISTRAL_API_KEY=
MISTRAL_MODEL=

# ---------------------------------------------------------------------------
# Rate limiting (optional)
#
# Without these, limits are counted per server instance in memory: fine
# locally, close to useless on serverless where requests spread across many
# instances. https://console.upstash.com
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Salt for hashing client IPs. Raw IPs are never stored or logged.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RATELIMIT_SALT=
