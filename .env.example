# ---- LLM fallback chain (all free tiers, no card required) ----
# Providers are tried in order. Any with a blank key is skipped. With none set,
# the app still works and serves canned verdicts.

# 1. Cerebras — ~1M tokens/day free, fastest. https://cloud.cerebras.ai
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b

# 2. Groq — ~1k req/day per model free. https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# 3. Google Gemini — free tier via AI Studio. https://aistudio.google.com
GEMINI_API_KEY=
# An alias that tracks the current Flash release, so a rename upstream
# does not silently drop us to canned verdicts.
GEMINI_MODEL=gemini-flash-latest

# ---- Rate limiting (optional) ----
# Without these, limits are enforced per-instance in memory (leaky on serverless
# but free and zero-config). https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Salt for hashing client IPs. Raw IPs are never stored. Set this in production.
RATELIMIT_SALT=
